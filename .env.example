# Copier vers .env (listé dans .gitignore). Ne jamais committer .env.
# Noms de variables uniquement, valeurs vides.

# --- France Travail (lot M1) ---
# Créer une application sur https://francetravail.io et activer l'API « Offres d'emploi v2 »
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Facultatif : scope indiqué dans la doc de ton application (défaut : api_offresdemploiv2 o2dsoffre)
FT_SCOPE=

# --- Adzuna (lot M2) ---
# Clés sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Alertes email : lecture IMAP en lecture seule ---
# Dossier (ou libellé Gmail) dédié, par exemple Vigie/Alertes.
# Gmail : utiliser un mot de passe d'application (Compte Google > Sécurité), jamais le mot de passe du compte.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=

# --- Envoi du digest par email (lot M2) ---
# Paramètres SMTP de ton fournisseur (mot de passe d'application recommandé)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# --- État persistant (lot M2) ---
# Bucket S3 privé (versioning, chiffrement, accès public bloqué)
VIGIE_STATE_BUCKET=
# Critères de recherche réels (contenu YAML), fournis en secret en CI
VIGIE_RADAR_CONFIG=

# --- Stockage local (facultatif) ---
# Chemin de la base SQLite (défaut : ~/.local/share/vigie/radar.db)
VIGIE_DB_PATH=
