# PRÉVU : ces variables décrivent la cible, aucun module ne les lit encore.
# Copier vers .env et ne jamais committer .env.

# --- radar : sources d'offres ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JobSpy reste désactivé par défaut
RADAR_ENABLE_JOBSPY=false

# --- match : embeddings et LLM ---
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=
MATCH_TOP_K=10

# --- profil ---
# Le dépôt public utilise le profil fictif ; le vrai CV reste hors dépôt.
PROFILE_PATH=data/profile.demo.yaml

# --- déploiement AWS (phase serverless) ---
AWS_REGION=eu-west-3
DYNAMODB_TABLE=vigie-offers
